{
  "name": "sdd-todo-app",
  "version": "0.1.0",
  "private": true,
  "description": "Personal TODO list on Cloudflare Workers + D1, built with Spec-Driven Development (GitHub Spec Kit)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite build && wrangler d1 migrations apply todo-db --local && wrangler dev",
    "build": "vite build && wrangler deploy --dry-run --outdir dist/worker",
    "pretest": "vite build --logLevel warn",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/client",
    "db:migrate:local": "wrangler d1 migrations apply todo-db --local",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.17"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.1",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "~4.1",
    "wrangler": "^4.159.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261109.1": true
  }
}
